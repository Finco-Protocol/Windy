# Windy backend configuration — copy to .env and adjust if needed.
# No API keys are required: Windy uses the free Open-Meteo endpoints.
# NEVER put real secrets or production data in this file or in git.

# SQLite database location (the only persistent state).
WINDY_DB_PATH=./data/windy.db

# Optional twice-daily collection scheduler (00:00 and 12:00 UTC by default).
# 0 = disabled (default; use `python -m app.cli collect` or cron instead).
WINDY_SCHEDULER_ENABLED=0
WINDY_SCHEDULE_CRON=0 0,12 * * *

# Open-Meteo request tuning.
WINDY_OM_TIMEOUT_S=40
WINDY_OM_MAX_RETRIES=3

# Default collection depth in days (clamped per model: ICON-EU max 5, ICON Global ~8).
WINDY_COLLECT_DAYS=10

# CORS origins for `vite dev`.
WINDY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
